{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "workspaceId": { "type": "string" } },
  "triggers": { /* Same Sentinel trigger */ },
  "actions": {
    "Revoke_All_Sessions": { /* Same as above */ },
    "Force_Password_Reset": { /* Same as above */ },
    "Disable_User_If_Critical": {
      "type": "ApiConnection",
      "inputs": {
        "host": { "connectionName": "graph" },
        "method": "patch",
        "path": "/users/@{variables('userId')}",
        "body": { "accountEnabled": false }
      }
    },
    "Block_Source_IP": { /* Call Azure Firewall or NSG */ },
    "Notify_On_Teams": {
      "type": "ApiConnection",
      "inputs": { "host": { "connectionName": "teams" } }
    },
    "Update_Incident": { /* Mark as Resolved or Assigned */ }
  }
}
