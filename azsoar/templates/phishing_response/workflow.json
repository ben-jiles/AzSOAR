{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceId": { "type": "string" }
  },
  "triggers": {
    "When_a_response_to_an_Azure_Sentinel_alert_is_triggered": {
      "type": "Microsoft.Sentinel",
      "inputs": { "body": { "alertRuleId": "" } }
    }
  },
  "actions": {
    "Parse_Incident": {
      "type": "ParseJson",
      "inputs": { "content": "@triggerBody()" }
    },
    "Revoke_Sessions": {
      "type": "ApiConnection",
      "inputs": {
        "host": { "connectionName": "graph" },
        "method": "post",
        "path": "/users/@{body('Parse_Incident')?['properties']?['additionalData']?['entities']?[0]?['userPrincipalName']}/revokeSignInSessions"
      }
    },
    "Force_Password_Reset": {
      "type": "ApiConnection",
      "inputs": {
        "host": { "connectionName": "graph" },
        "method": "patch",
        "path": "/users/@{body('Parse_Incident')?['properties']?['additionalData']?['entities']?[0]?['userPrincipalName']}",
        "body": { "passwordProfile": { "forceChangePasswordNextSignIn": true } }
      },
      "runAfter": { "Revoke_Sessions": ["Succeeded"] }
    },
    "Conditional_Disable_Account": {
      "type": "If",
      "expression": "@equals(body('Parse_Incident')?['properties']?['severity'], 'High')",
      "actions": {
        "Disable_User": {
          "type": "ApiConnection",
          "inputs": {
            "host": { "connectionName": "graph" },
            "method": "patch",
            "path": "/users/@{body('Parse_Incident')?['properties']?['additionalData']?['entities']?[0]?['userPrincipalName']}",
            "body": { "accountEnabled": false }
          }
        }
      }
    },
    "Update_Incident": {
      "type": "ApiConnection",
      "inputs": {
        "host": { "connectionName": "azuresentinel" },
        "method": "put",
        "path": "/Incidents/@{triggerBody()?['objectId']}",
        "body": { "status": "Resolved", "severity": "Medium" }
      }
    }
  }
}
