{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "workspaceId": { "type": "string" } },
  "variables": {
    "affectedHost": "@body('Parse_Incident')?['properties']?['additionalData']?['entities'][0]?['hostName']"
  },
  "actions": {
    "Parse_Incident": { "type": "ParseJson", "inputs": { "content": "@triggerBody()" } },
    "Isolate_VM": {
      "type": "ApiConnection",
      "inputs": {
        "host": { "connectionName": "azurecompute" },
        "method": "post",
        "path": "/subscriptions/@{parameters('subscriptionId')}/resourceGroups/@{parameters('resourceGroup')}/providers/Microsoft.Compute/virtualMachines/@{variables('affectedHost')}/powerOff"
      }
    },
    "Block_Malicious_IPs": { /* NSG / Firewall */ },
    "Disable_Compromised_Accounts": { /* Graph API */ },
    "Quarantine_Blobs": {
      "type": "ApiConnection",
      "inputs": { "host": { "connectionName": "storage" } }
    },
    "Notify_Leadership": {
      "type": "ApiConnection",
      "inputs": { "host": { "connectionName": "teams" } }
    }
  }
}
